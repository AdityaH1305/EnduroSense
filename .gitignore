# Data: raw files are large and downloadable (see README); derived data is regenerated by scripts
data/raw/
data/features/
# samples.parquet is 46 MB and rebuilt by scripts/02_prepare_data.py in seconds
data/processed/samples.parquet
# NOTE: data/splits/ IS versioned - the locked split must never change

# Trained models are regenerated by scripts
models/

# Cross-validation cache (22 MB; rebuilt by scripts/05_model_a.py)
results/model_a/cache/
results/uncertainty/cache_*.parquet
# 5 MB of held-out quantiles per reading; rebuilt by scripts/07_uncertainty.py, read by scripts/08_decisions.py
results/uncertainty/model_a_oof_quantiles.parquet
# timings of the last full rebuild (changes every run)
results/run_all_log.json
# rehearsal of the final evaluation on development rows: numbers are meaningless, never kept
results/final_rehearsal/

